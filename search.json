---
layout: null
---
[
  {% assign searchable = site.posts | concat: site.pages %}
  {% assign filtered = searchable | where_exp: "item", "item.title" %}
  {% for item in filtered %}
    {
      "title"   : {{ item.title | jsonify }},
      "content" : {{ item.content | strip_html | strip_newlines | jsonify }},
      "url"     : {{ item.url | relative_url | jsonify }},
      "date"    : {{ item.date | date_to_string | jsonify }},
      "image" : {{ item.image | default: "/favicon.ico" | relative_url | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
